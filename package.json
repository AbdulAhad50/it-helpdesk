    "admin:create": "tsx --env-file=.env.local scripts/create-admin.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:all": "vitest run && tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@node-rs/argon2": "^2.2.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.8.1",
    "lucide-react": "^1.59.0",
    "mongodb": "^7.7.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
