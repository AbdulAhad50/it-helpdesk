    {
      "parameters": {
        "jsCode": "// Validate the payload sent by the helpdesk app. Reject anything unexpected before touching the sheet.\nconst COLUMNS = [\"Transfer ID\", \"Direction\", \"Outlet\", \"Name\", \"Email\", \"Contact\", \"Description\", \"Status\", \"Date\", \"Time\", \"Received Date\", \"Received Time\", \"Received By\", \"Receipt Notes\", \"Logged By\", \"Last Updated\"];\nconst item = $input.first().json;\nconst body = item.body || {};\nconst fail = (reason) => [{ json: { valid: false, reason, spreadsheetId: item.spreadsheetId, sheetName: item.sheetName, eventId: body.eventId ?? null, transferId: body.transferId ?? null } }];\nif (body.schemaVersion !== 1) return fail('unsupported schemaVersion');\nif (body.eventType !== 'transfer.received') return fail('unexpected eventType');\nif (typeof body.transferId !== 'string' || !/^TR-\\d{8}-[A-HJKMNP-Z2-9]{4}$/.test(body.transferId)) return fail('invalid transferId');\nif (typeof body.eventId !== 'string' || !body.eventId.startsWith('transfer.received:' + body.transferId)) return fail('eventId does not match transferId');\nconst row = body.row;\nif (!row || typeof row !== 'object') return fail('row missing');\nfor (const c of COLUMNS) {\n  if (typeof row[c] !== 'string') return fail('column missing or not text: ' + c);\n  if (row[c].length > 4000) return fail('column too long: ' + c);\n}\nif (row['Transfer ID'] !== body.transferId) return fail('row Transfer ID does not match transferId');\nreturn [{ json: { valid: true, spreadsheetId: item.spreadsheetId, sheetName: item.sheetName, eventId: body.eventId, transferId: body.transferId, eventType: body.eventType, row } }];\n"
      },
