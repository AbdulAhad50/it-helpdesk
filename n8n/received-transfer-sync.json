    {
      "parameters": {
        "jsCode": "// Count how many sheet rows carry this exact Transfer ID.\nconst v = $('Validate Payload').first().json;\nconst rows = $input.all().map((i) => i.json).filter((r) => r && String(r['Transfer ID'] ?? '').trim() === v.transferId);\nconst matchCount = rows.length;\nconst action = matchCount === 0 ? 'missing' : matchCount === 1 ? 'update' : 'duplicate';\nreturn [{ json: { action, matchCount, rowNumber: rows[0] ? (rows[0].row_number ?? null) : null, transferId: v.transferId, eventId: v.eventId, spreadsheetId: v.spreadsheetId, sheetName: v.sheetName } }];\n"
      },
