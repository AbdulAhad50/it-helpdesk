{
  "name": "Helpdesk C: Sync retry runner",
  "nodes": [
    {
      "parameters": {
        "content": "## C: Retry runner (every 15 min)\nCalls the app's /api/internal/sync/run, which retries any spreadsheet syncs that failed or were missed.\n1. Edit **Config**: your app's base URL (https, no trailing slash).\n2. Attach a Header Auth credential: name `Authorization`, value `Bearer <SYNC_RUNNER_SECRET>`.\n3. If anything needs attention the run fails on purpose, so n8n's failure notifications fire.\nReconciliation (comparing the sheet with MongoDB) is added to this workflow in Phase 7.",
        "height": 300,
        "width": 460
      },
      "id": "a5a2021c-697f-50bd-9eaf-79be3d459614",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        40
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "26a5b511-e3a0-5fc9-bc44-ed9efa1e769b",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        400
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "97639d37-d45c-5dc5-a454-1b5066f722ef",
              "name": "appBaseUrl",
              "value": "https://YOUR-APP.vercel.app",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "1450428a-55d4-5194-8246-560bb914b8a1",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.appBaseUrl }}/api/internal/sync/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": false,
        "options": {
          "timeout": 60000
        }
      },
      "id": "c26a1069-8152-5dd0-8390-c8e0aab3d5d9",
      "name": "Run Sync Retries",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        400
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Helpdesk sync runner secret"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "3f1e69b1-2b8a-5b34-8c22-452dc427ad2d",
              "leftValue": "={{ $json.data.queue.needsAttention }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "48762933-4fe2-5728-881b-104d514a4e9c",
      "name": "Needs Attention?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        400
      ]
    },
    {
      "parameters": {
        "errorMessage": "={{ $json.data.queue.needsAttention + ' complaint(s) have spreadsheet syncs that need attention. Open the admin dashboard.' }}"
      },
      "id": "4b6cecda-38c3-537c-be1c-84596c433343",
      "name": "Raise Alert",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        960,
        320
      ]
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Run Sync Retries",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Sync Retries": {
      "main": [
        [
          {
            "node": "Needs Attention?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs Attention?": {
      "main": [
        [
          {
            "node": "Raise Alert",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": false
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
