    {
      "parameters": {
        "jsCode": "// Count how many sheet rows carry this exact Complaint ID.\nconst v = $('Validate Payload').first().json;\nconst rows = $input.all().map((i) => i.json).filter((r) => r && String(r['Complaint ID'] ?? '').trim() === v.complaintId);\nconst matchCount = rows.length;\nconst action = matchCount === 0 ? 'append' : matchCount === 1 ? 'exists' : 'duplicate';\nreturn [{ json: { action, matchCount, rowNumber: rows[0] ? (rows[0].row_number ?? null) : null, complaintId: v.complaintId, eventId: v.eventId, spreadsheetId: v.spreadsheetId, sheetName: v.sheetName } }];\n"
      },
