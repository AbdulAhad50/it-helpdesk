    {
      "parameters": {
        "jsCode": "// Validate the payload sent by the helpdesk app. Reject anything unexpected before touching the sheet.\nconst COLUMNS = [\"Complaint ID\", \"User Name\", \"Department\", \"Problem Category\", \"Problem Description\", \"Priority\", \"Received Date\", \"Received Time\", \"Solved Date\", \"Resolve Time\", \"Solve Duration\", \"Work Stuck Reason\", \"Status\", \"Resolution Notes\", \"Resolved By\", \"Last Updated\"];\nconst item = $input.first().json;\nconst body = item.body || {};\nconst fail = (reason) => [{ json: { valid: false, reason, spreadsheetId: item.spreadsheetId, sheetName: item.sheetName, eventId: body.eventId ?? null, complaintId: body.complaintId ?? null } }];\nif (body.schemaVersion !== 1) return fail('unsupported schemaVersion');\nif (body.eventType !== 'complaint.created') return fail('unexpected eventType');\nif (typeof body.complaintId !== 'string' || !/^IT-\\d{8}-[A-HJKMNP-Z2-9]{4}$/.test(body.complaintId)) return fail('invalid complaintId');\nif (body.eventId !== 'complaint.created:' + body.complaintId) return fail('eventId does not match complaintId');\nconst row = body.row;\nif (!row || typeof row !== 'object') return fail('row missing');\nfor (const c of COLUMNS) {\n  if (typeof row[c] !== 'string') return fail('column missing or not text: ' + c);\n  if (row[c].length > 4000) return fail('column too long: ' + c);\n}\nif (row['Complaint ID'] !== body.complaintId) return fail('row Complaint ID does not match complaintId');\nreturn [{ json: { valid: true, spreadsheetId: item.spreadsheetId, sheetName: item.sheetName, eventId: body.eventId, complaintId: body.complaintId, eventType: body.eventType, row } }];\n"
      },
