# ── Copy to .env.local and fill in. Never commit real values. ──
APP_BASE_URL=http://localhost:3000

# MongoDB Atlas (Phase 2)
MONGODB_URI=
MONGODB_DB_NAME=it_helpdesk

# Random 32+ char secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Used as the key when hashing client IPs and login emails for rate limiting, so raw values are never stored.
# (Admin sessions are random server-side tokens, not signed with this secret.)
AUTH_SECRET=

# n8n Cloud. Spreadsheet sync stays "awaiting configuration" until these are set.
# Production webhook URLs (not the "test" URLs) from the Webhook nodes in workflows A and B. Must be https.
N8N_NEW_COMPLAINT_WEBHOOK_URL=
N8N_UPDATE_COMPLAINT_WEBHOOK_URL=
# Item transfers ("received and out"): production URLs of workflows D and E. Optional, independent of the above.
N8N_TRANSFER_CREATED_WEBHOOK_URL=
N8N_TRANSFER_UPDATED_WEBHOOK_URL=
# App -> n8n shared secret (sent as the X-Webhook-Secret header). 32+ random characters.
N8N_WEBHOOK_SECRET=
# n8n -> app secret for the retry runner (/api/internal/sync/run). A DIFFERENT 32+ character value.
# Leave empty to disable the runner endpoint.
SYNC_RUNNER_SECRET=

# Google Sheets. The sheet is written by n8n using ITS OWN Google credential (see n8n/README.md).
# These app-side values are only needed for reconciliation reads (Phase 7); safe to leave empty until then.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=IT Complaints
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
